TEXT_PROVIDER=deepseek
TEXT_API_KEY=
TEXT_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-flash
TEXT_ENDPOINT_PATH=/chat/completions
# Set to true only when TEXT_MODEL can read images. deepseek-flash cannot.
