IMAGE_PROVIDER=bailian
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com
IMAGE_MODEL=wan2.2-t2i-flash
IMAGE_ENDPOINT_PATH=/api/v1/services/aigc/text2image/image-synthesis

DEEPSEEK_API_KEY=
BAILIAN_API_KEY=
SILICONFLOW_API_KEY=

